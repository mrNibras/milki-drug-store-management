{
  "DataDirectory": "/var/data",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/var/data/MilkiDrugStoreDB.db"
  },
  "JwtSettings": {
    "Secret": "CHANGE_ME_IN_PRODUCTION_USE_A_STRONG_RANDOM_KEY_AT_LEAST_32_CHARS",
    "Issuer": "MilkiDrugStore",
    "Audience": "MilkiDrugStoreClient",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "https://milki-drug-store-management.vercel.app"
    ]
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderName": "Milki Drug Store",
    "SenderEmail": "milki.drug.store@gmail.com",
    "Username": "",
    "Password": ""
  },
  "AdminEmail": "admin@milki.com",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
