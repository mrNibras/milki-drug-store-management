{
  "ConnectionStrings": {},
  "JwtSettings": {
    "Secret": "CHANGE_ME_IN_PRODUCTION_USE_A_STRONG_RANDOM_KEY_AT_LEAST_32_CHARS",
    "Issuer": "MilkiDrugStore",
    "Audience": "MilkiDrugStoreClient",
    "ExpiryMinutes": 60
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "SenderName": "Milki Drug Store",
    "SenderEmail": "milki.drug.store@gmail.com",
    "Username": "",
    "Password": ""
  },
  "FileStorage": {
    "Provider": "s3",
    "S3": {
      "BucketName": "milki-drug-store-uploads",
      "Region": "us-east-1"
    }
  },
  "DatabaseMonitoring": {
    "WarningThresholdGB": 5,
    "CriticalThresholdGB": 10
  },
  "Retention": {
    "AuditLogRetentionDays": 1095,
    "NotificationRetentionDays": 180
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
