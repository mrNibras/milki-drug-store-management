@startuml
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor<<staff>> #eaf3ff
    BorderColor<<staff>> #4274aa
    BackgroundColor<<admin>> #ecf8f0
    BorderColor<<admin>> #478262
    BackgroundColor<<system>> #fef3c7
    BorderColor<<system>> #f59e0b
    BackgroundColor<<auth>> #fce7f3
    BorderColor<<auth>> #ec4899
}

actor "Pharmacist" as Pharmacist
actor "Admin" as Admin
actor "System" as System

Admin -|> Pharmacist

rectangle "Milki Drug Store Management System" {

  package "Authentication & Security" {
    usecase "UC-01: Login" as UC01 <<auth>>
    usecase "UC-02: Register (Pending Approval)" as UC02 <<auth>>
    usecase "UC-03: Change Password" as UC03 <<auth>>
    usecase "UC-04: Forgot/Reset Password" as UC04 <<auth>>
    usecase "UC-05: Token Refresh" as UC05 <<auth>>
    usecase "UC-06: Approve User (Admin)" as UC06 <<admin>>
  }

  package "Point of Sale (POS)" {
    usecase "UC-07: Search Products" as UC07 <<staff>>
    usecase "UC-08: Add to Cart (FEFO Batch)" as UC08 <<staff>>
    usecase "UC-09: Manage Cart (Qty, Discount)" as UC09 <<staff>>
    usecase "UC-10: Apply Discount (w/ Reason)" as UC10 <<staff>>
    usecase "UC-11: Process Sale (Multi-Payment)" as UC11 <<staff>>
    usecase "UC-12: Generate/Print Receipt" as UC12 <<staff>>
  }

  package "Inventory Management" {
    usecase "UC-13: View Unified Inventory" as UC13 <<staff>>
    usecase "UC-14: Filter/Search Inventory" as UC14 <<staff>>
    usecase "UC-15: View Batch Details" as UC15 <<staff>>
    usecase "UC-16: Monitor Low Stock" as UC16 <<staff>>
    usecase "UC-17: View Inventory Valuation" as UC17 <<admin>>
  }

  package "Medicine Management" {
    usecase "UC-18: Create Medicine" as UC18 <<admin>>
    usecase "UC-19: Update Medicine" as UC19 <<admin>>
    usecase "UC-20: Delete Medicine" as UC20 <<admin>>
    usecase "UC-21: Add Medicine Batch" as UC21 <<admin>>
  }

  package "Cosmetic Management" {
    usecase "UC-22: Create Cosmetic" as UC22 <<admin>>
    usecase "UC-23: Update Cosmetic" as UC23 <<admin>>
    usecase "UC-24: Delete Cosmetic" as UC24 <<admin>>
    usecase "UC-25: Add Cosmetic Batch" as UC25 <<admin>>
  }

  package "Purchase Management" {
    usecase "UC-26: View Purchases" as UC26 <<admin>>
    usecase "UC-27: Create Purchase Order" as UC27 <<admin>>
    usecase "UC-28: View Purchase Details" as UC28 <<admin>>
  }

  package "Supplier Management" {
    usecase "UC-29: View Suppliers" as UC29 <<admin>>
    usecase "UC-30: Create Supplier" as UC30 <<admin>>
    usecase "UC-31: Update Supplier" as UC31 <<admin>>
    usecase "UC-32: Delete Supplier" as UC32 <<admin>>
  }

  package "Damage & Expiry Management" {
    usecase "UC-33: View Expiring Soon (Auto)" as UC33 <<system>>
    usecase "UC-34: View Expired Items (Auto)" as UC34 <<system>>
    usecase "UC-35: Record Damage (Manual)" as UC35 <<staff>>
    usecase "UC-36: View Damage History" as UC36 <<staff>>
  }

  package "Reports & Analytics" {
    usecase "UC-37: Dashboard Summary" as UC37 <<admin>>
    usecase "UC-38: Sales Report" as UC38 <<admin>>
    usecase "UC-39: Most Selling Report" as UC39 <<admin>>
    usecase "UC-40: Inventory Report" as UC40 <<admin>>
    usecase "UC-41: Profit Report" as UC41 <<admin>>
    usecase "UC-42: Supplier Report" as UC42 <<admin>>
    usecase "UC-43: Staff Report" as UC43 <<admin>>
    usecase "UC-44: Export Reports" as UC44 <<admin>>
  }

  package "Branch Management" {
    usecase "UC-45: View Branches" as UC45 <<admin>>
    usecase "UC-46: Create Branch" as UC46 <<admin>>
    usecase "UC-47: Update Branch" as UC47 <<admin>>
    usecase "UC-48: Delete Branch" as UC48 <<admin>>
    usecase "UC-49: Switch Branch Context" as UC49 <<staff>>
  }

  package "User Management" {
    usecase "UC-50: View Users" as UC50 <<admin>>
    usecase "UC-51: Create User" as UC51 <<admin>>
    usecase "UC-52: Update User" as UC52 <<admin>>
    usecase "UC-53: Delete User" as UC53 <<admin>>
    usecase "UC-54: Approve User Registration" as UC54 <<admin>>
  }

  package "Settings & Audit" {
    usecase "UC-55: Manage System Settings" as UC55 <<admin>>
    usecase "UC-56: View Audit Logs" as UC56 <<admin>>
    usecase "UC-57: View Notifications" as UC57 <<staff>>
  }
}

